# ─── ShiftzyGo environment variables ──────────────────────────────────
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed.

# Node environment: "development" or "production".
# The dev/start npm scripts set this automatically via cross-env; only set it
# here if you run the server some other way.
NODE_ENV=development

# ─── Stripe ───────────────────────────────────────────────────────────
# Use TEST keys (sk_test_... / pk_test_...) while validating the V1 pilot.
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_test_publishable_key

# ─── Database (PostgreSQL) ────────────────────────────────────────────
# Required by `npm run db:push` (drizzle-kit) and by the server from
# Phase 1 onward. On Replit this is provided automatically once a
# PostgreSQL database is attached to the project.
DATABASE_URL=postgresql://user:password@host:5432/shiftzygo

# ─── Session security ─────────────────────────────────────────────────
# Added in Phase 1 (real email + password accounts). A long random string
# used to sign the login session cookie. Required — the server refuses to
# start without it. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# ─── Cashfree Payment Gateway ────────────────────────────────────────
# Added in Phase 2 for the real vehicle-shifting payment flow
# (ShiftRequest → priced Trip → payment). Use SANDBOX / TEST credentials
# while validating the V1 pilot: Cashfree Dashboard → Developers → API Keys,
# with the environment switched to "Sandbox".
# If these are left blank the payment endpoints return a clear
# "gateway not configured" error instead of failing silently.
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Optional — override only if Cashfree tells you to:
# CASHFREE_API_VERSION=2023-08-01

# Public base URL of this app. Used to build the Cashfree return_url and
# webhook notify_url. For local dev the default is fine; set it to the real
# deployed URL in production so the webhook can reach this server.
APP_BASE_URL=http://localhost:5000
